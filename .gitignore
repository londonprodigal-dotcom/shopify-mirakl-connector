*.db
*.db-*
*.sqlite
*.sqlite3
data/
/tmp/

# secrets — all credentials are injected as Railway env vars at runtime
.env
.env.*
*.env
credentials/

# logs / editor noise
*.log
npm-debug.log*
.DS_Store

*.bak
.env*
node_modules/
